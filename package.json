{
  "name": "assert-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "npm --prefix assert_PLATFORM run api",
    "web": "npm --prefix assert_WEB run web",
    "start": "npm --prefix assert_PLATFORM run start",
    "web:install": "npm --prefix assert_WEB install",
    "platform:install": "npm --prefix assert_PLATFORM install",
    "release:publish": "node scripts/publish-release.mjs",
    "push:setup": "node scripts/setup-github-push.mjs",
    "push:github": "node scripts/push-github.mjs",
    "lint": "eslint . --ext .js,.mjs,.cjs",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,md,css,html}\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {},
  "devDependencies": {
    "better-sqlite3": "^12.4.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
