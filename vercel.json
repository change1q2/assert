{
  "buildCommand": "cd assert_WEB && npm run build",
  "installCommand": "cd assert_WEB && npm install",
  "outputDirectory": "assert_WEB/dist",
  "rewrites": [
    { "source": "/vi-api/(.*)", "destination": "http://119.28.189.98:5000/api/$1" },
    { "source": "/api/(.*)", "destination": "http://119.28.189.98/api/$1" },
    { "source": "/((?!api|vi-api).*)", "destination": "/index.html" }
  ]
}
