# MySQL 数据库主机地址
MYSQL_HOST=127.0.0.1
# MySQL 数据库端口
MYSQL_PORT=3306
# MySQL 数据库用户名
MYSQL_USER=root
# MySQL 数据库密码
MYSQL_PASSWORD=123456
# MySQL 数据库名称
MYSQL_DATABASE=asset_platform
# API 服务监听端口
API_PORT=3000
# 跨域白名单，多个域名用逗号分隔（可选）
EXTRA_ORIGINS=
# 发布包存储目录路径（可选）
RELEASES_ROOT=
# 短信服务 Webhook 地址（可选）
SMS_WEBHOOK_URL=
# 短信服务 Webhook 认证 Token（可选）
SMS_WEBHOOK_TOKEN=
# 管理员默认密码
ADMIN_PASSWORD=admin123
# 港股打新数据文件路径（可选）
HK_IPO_SOURCE_FILE=
