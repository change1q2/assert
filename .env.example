# 环境变量模板 - 复制此文件为 .env 并填写真实值
# Copy this file to .env and fill in your actual values
#
# ⚠️ 安全提示：.env 文件包含敏感信息，请勿提交到 Git
# / Never commit .env to Git - it contains sensitive credentials

# ==========
# MySQL 数据库配置
# ==========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>

# ==========
# 数据库名称（通常不需修改）
# ==========
MYSQL_DATABASE=asset_platform

# ==========
# API 服务端口
# ==========
API_PORT=3000

# ==========
# 跨域白名单（逗号分隔，开发环境已内置 localhost:4173）
# ==========
EXTRA_ORIGINS=

# ==========
# 发布包目录（可选，默认 assert_PLATFORM/releases）
# ==========
RELEASES_ROOT=

# ==========
# 短信服务 Webhook（用于发送验证码）
# ==========
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ==========
# 管理员默认密码（首次启动创建，之后修改数据库生效）
# ⚠️ 必须使用强密码！
# ==========
ADMIN_PASSWORD=<your-admin-password>

# ==========
# 港股打新数据源文件（可选）
# 默认为项目 tools/ 目录下的 build_hk_ipo_current.mjs
# ==========
HK_IPO_SOURCE_FILE=
